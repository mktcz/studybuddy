<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sb_ink"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="0m" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/sb_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="0dp"
            android:textColor="@color/sb_muted"
            android:textSize="11sp"
            android:text="@string/widget_streak_label" />
    </LinearLayout>


    <ImageView
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:adjustViewBounds="true"
        android:scaleType="fitStart"
        android:contentDescription="@string/widget_grid_description" />


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_0"
            style="@style/WidgetChip"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_chip_1"
            style="@style/WidgetChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/widget_chip_2"
            style="@style/WidgetChip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
